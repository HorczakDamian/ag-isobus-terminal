# ===================================================================
# Git Ignore for ISOBUS Universal Terminal & AgOpenGPS Task Controller
# ===================================================================

# Build directories & intermediate outputs
build/
build_*/
bin/
obj/
x64/
Debug/
Release/
CMakeFiles/
CMakeCache.txt

# Binary executables, libraries & debug symbols
*.exe
*.dll
*.pdb
*.lib
*.ilk
*.exp
*.obj
*.idb
*.zip

# Dynamic caches, crash logs & user settings
*.log
*.dmp
*.ini
imgui.ini
vt_settings.ini

# Firmwares & external docs
esp32_machine_examples/
isobus_esp32_client/
docs/
tools/
AgIsoStack-plus-plus-main/
AgIsoStack*/
ESP32_ISOBUS-master/
NeptuneGPS_Triton-main/
arduino_uno_isobus_machine/
isobus_sdk/

# Runtime task data & reports
Raporty_SOR/
TASKDATA/
aux_inputs/
isobus_file_server/
*.html

# Whitelist AgOpenGPS & AOG-TaskController suites
!agopen/
!agopen/**
!tcagopen/
!tcagopen/**

# Visual Studio & IDE artifacts
.vs/
*.sln.docstates
*.user
*.suo
.vscode/

# Whitelist ready-to-run root executables, libraries and default configuration
!isobus_vt_terminal.exe
!PCANBasic.dll
!AOG-TaskController.exe
!vt_settings.ini

!object_pool_cache/
!object_pool_cache/**

# Temporary research dumps and scratch scripts
/scratch_*.py
/find_*.py
/check_*.py
/read_*.py
/zoom_*.py
/search_*.py
/connector_crop.jpg
/svgs/
/*_analysis.txt
/*_summary.txt
/connectors_*.txt
/deutz_can_findings.txt
/diag_*.txt
/parsed_*.txt
/r001_info.txt
/side_console_harness.txt
/svg_extracted_texts.txt
/tables_overview.txt
